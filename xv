    function updateChartsData(totalDays, totalItems, itemScores) {
      if (!chartTrend) return;
      const trendLabels = [];
      const trendData = [];
      for (let d = 1; d <= totalDays; d++) {
        trendLabels.push(`D${d}`);
        let dayCount = 0;
        if (appState.items) {
          appState.items.forEach(it => {
            if (appState.checks[it.id] && appState.checks[it.id][d]) dayCount++;
          });
        }
        trendData.push(totalItems > 0 ? Math.round((dayCount / totalItems) * 100) : 0);
      }
      chartTrend.data.labels = trendLabels;
      chartTrend.data.datasets[0].data = trendData;
      chartTrend.update();

      if (itemScores.length > 0) {
        chartDoughnut.data.labels = itemScores.map(it => it.name.substring(0, 10));
        chartDoughnut.data.datasets[0].data = itemScores.map(it => it.totalHoursSpent);
      } else {
        chartDoughnut.data.labels = ['Empty'];
        chartDoughnut.data.datasets[0].data = [1];
      }
      chartDoughnut.update();

      chartRadar.data.labels = itemScores.map(it => it.name.substring(0, 8));
      chartRadar.data.datasets[0].data = itemScores.map(it => Math.round(it.ratio * 100));
      chartRadar.update();

      const weeks = [
        { start: 1, end: 7 }, { start: 8, end: 14 },
        { start: 15, end: 21 }, { start: 22, end: 28 }, { start: 29, end: totalDays }
      ];
      chartWeekly.data.datasets[0].data = weeks.map(w => {
        let total = 0;
        for (let d = w.start; d <= Math.min(w.end, totalDays); d++) {
          if (appState.items) {
            appState.items.forEach(it => {
              if (appState.checks[it.id] && appState.checks[it.id][d]) total += (it.hours || 1);
            });
          }
        }
        return total;
      });
      chartWeekly.update();
    }

