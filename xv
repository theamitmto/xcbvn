<!DOCTYPE html>
<html lang="hi" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0284c7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Smart Study Pro - Ultimate Aspirant OS & Syllabus Tracker</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- Canvas Confetti CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
  <!-- QRCode.js CDN for sharing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: ['class', '#super-tracker-root.dark'],
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'Noto Sans Devanagari', 'sans-serif'],
            display: ['"Plus Jakarta Sans"', 'Noto Sans Devanagari', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>

  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }

    #super-tracker-root {
      /* DEFAULT TO LUXURIOUS LIGHT MODE */
      --st-bg: #f8fafc;
      --st-card: rgba(255, 255, 255, 0.96);
      --st-card-solid: #ffffff;
      --st-card-subtle: #f1f5f9;
      --st-border: #e2e8f0;
      --st-border-focus: #0284c7;
      --st-text-head: #0f172a;
      --st-text-body: #334155;
      --st-text-muted: #64748b;
      --st-primary: #0284c7;
      --st-primary-glow: rgba(2, 132, 199, 0.22);
      --st-accent: #059669;
      --st-checkbox-bg: #f8fafc;
      --st-checkbox-border: #cbd5e1;
      --st-sticky-col: #ffffff;
      font-family: 'Inter', 'Noto Sans Devanagari', sans-serif;
      color: var(--st-text-body);
      background-color: var(--st-bg);
      line-height: 1.5;
      min-height: 100vh;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: calc(env(safe-area-inset-bottom, 16px) + 84px);
    }

    #super-tracker-root.dark {
      --st-bg: #090d16;
      --st-card: rgba(16, 22, 38, 0.94);
      --st-card-solid: #101626;
      --st-card-subtle: #172033;
      --st-border: #1e293b;
      --st-border-focus: #38bdf8;
      --st-text-head: #f8fafc;
      --st-text-body: #cbd5e1;
      --st-text-muted: #64748b;
      --st-primary: #38bdf8;
      --st-primary-glow: rgba(56, 189, 248, 0.25);
      --st-accent: #10b981;
      --st-checkbox-bg: #141c2e;
      --st-checkbox-border: #28374d;
      --st-sticky-col: #101626;
    }

    #super-tracker-root .st-glass {
      background-color: var(--st-card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--st-border);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    }
    #super-tracker-root.dark .st-glass {
      box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.55);
    }

    #super-tracker-root .st-subtle {
      background-color: var(--st-card-subtle);
      border: 1px solid var(--st-border);
    }

    #super-tracker-root .st-checkbox {
      appearance: none;
      -webkit-appearance: none;
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      background: var(--st-checkbox-bg);
      border: 2px solid var(--st-checkbox-border);
      border-radius: 12px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
      outline: none;
      position: relative;
    }
    #super-tracker-root .st-checkbox:checked {
      background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);
      border-color: #38bdf8;
      box-shadow: 0 0 14px rgba(56, 189, 248, 0.55);
      animation: stCheckPop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    #super-tracker-root .st-checkbox:checked::after {
      content: '✓';
      color: #ffffff;
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
    }

    @keyframes stCheckPop {
      0% { transform: scale(0.75); }
      50% { transform: scale(1.22); }
      100% { transform: scale(1); }
    }
    @keyframes stFadeInUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes stFloat {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-3px) rotate(2deg); }
    }
    @keyframes stFlamePulse {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 4px rgba(245, 158, 11, 0.5)); }
      50% { transform: scale(1.15); filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.7)); }
    }
    @keyframes stSoundBarBounce {
      0%, 100% { height: 6px; }
      50% { height: 22px; }
    }
    @keyframes stRotateRing {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .st-sound-bar {
      width: 3.5px;
      border-radius: 9999px;
      background: linear-gradient(180deg, #38bdf8 0%, #2563eb 100%);
      animation: stSoundBarBounce 1.1s ease-in-out infinite;
    }
    .st-sound-bar:nth-child(2) { animation-delay: 0.15s; }
    .st-sound-bar:nth-child(3) { animation-delay: 0.3s; }
    .st-sound-bar:nth-child(4) { animation-delay: 0.45s; }

    .st-animate-fade {
      animation: stFadeInUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .st-float-icon {
      display: inline-block;
      animation: stFloat 3.2s ease-in-out infinite;
    }
    .st-flame-icon {
      display: inline-block;
      animation: stFlamePulse 1.8s ease-in-out infinite;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    @media print {
      body * { visibility: hidden; }
      #printReportSection, #printReportSection * { visibility: visible; }
      #printReportSection {
        position: absolute; left: 0; top: 0; width: 100%;
        background: #ffffff !important; color: #000000 !important;
      }
    }
  </style>
</head>
<body class="m-0 p-0 bg-slate-900">

  <!-- ROOT MOBILE CONTAINER -->
  <div id="super-tracker-root" class="w-full min-h-screen transition-colors duration-200">
    
    <!-- TOP STICKY MOBILE APP BAR -->
    <header class="sticky top-0 z-40 bg-[var(--st-card)]/90 backdrop-blur-md border-b border-[var(--st-border)] px-3.5 py-2.5 shadow-sm">
      <div class="flex items-center justify-between gap-2 max-w-md mx-auto">
        
        <!-- Identity Branding & Student Name -->
        <div class="flex items-center gap-2 truncate">
          <div class="w-9 h-9 min-w-[36px] rounded-xl bg-gradient-to-tr from-sky-500 via-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-sky-500/25 text-lg font-black st-float-icon">
            🎯
          </div>
          <div class="truncate">
            <h1 class="text-sm font-display font-black tracking-tight text-[var(--st-text-head)] leading-none">
              Smart Study <span class="text-sky-500">Pro</span>
            </h1>
            <div class="flex items-center gap-1.5 mt-1">
              <button onclick="openExamSetupModal()" class="text-[10px] font-bold text-sky-600 dark:text-sky-400 flex items-center gap-0.5 truncate max-w-[120px]">
                <span id="displayHeaderStudentName">Aspirant</span> ✏️
              </button>
              <span id="badgeRank" class="text-[9px] font-black uppercase px-1.5 py-0.2 rounded bg-indigo-500/10 text-indigo-500 border border-indigo-500/20 truncate">
                Novice
              </span>
            </div>
          </div>
        </div>

        <!-- Quick Top Action Buttons -->
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <button onclick="openSubjectModal()" class="w-8 h-8 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 text-white font-black text-base flex items-center justify-center shadow-md active:scale-95" title="नया विषय जोड़ें">
            +
          </button>
          <button onclick="openManageDrawer()" class="w-8 h-8 rounded-xl st-subtle text-xs flex items-center justify-center text-[var(--st-text-head)] active:scale-95" title="मैनेज">
            ⚙️
          </button>
          <button onclick="toggleAppLanguage()" class="px-2 h-8 rounded-xl st-subtle text-[11px] font-bold text-sky-500 flex items-center justify-center active:scale-95">
            <span id="mobileLangLabel">EN</span>
          </button>
          <button onclick="toggleAppTheme()" class="w-8 h-8 rounded-xl st-subtle text-xs flex items-center justify-center text-[var(--st-text-head)] active:scale-95" title="थीम">
            <span id="mobileThemeIcon">🌙</span>
          </button>
          <button onclick="toggleSoundFx()" id="btnMobileSound" class="w-8 h-8 rounded-xl st-subtle text-xs flex items-center justify-center active:scale-95" title="ध्वनि">
            🔊
          </button>
        </div>

      </div>

      <!-- Compact Exam Countdown Banner -->
      <div class="mt-2 flex items-center justify-between px-3 py-1.5 rounded-xl st-subtle border border-indigo-500/25 bg-indigo-500/5 text-[11px] max-w-md mx-auto">
        <div class="flex items-center gap-1.5 truncate">
          <span>⏳</span>
          <span class="font-extrabold text-sky-600 dark:text-sky-400 truncate max-w-[140px]" id="displayTargetExamName">Target Exam</span>
          <button onclick="openExamSetupModal()" class="text-[9px] text-[var(--st-text-muted)] hover:text-sky-500">✏️</button>
        </div>
        <div class="font-mono font-black text-indigo-600 dark:text-indigo-300 text-xs flex items-center gap-1 flex-shrink-0" id="countdownDisplay">
          <span id="cdDays">00</span>d : <span id="cdHours">00</span>h : <span id="cdMins">00</span>m
        </div>
      </div>
    </header>

    <!-- MAIN SCROLLABLE MOBILE CONTENT CONTAINER -->
    <main class="p-3.5 space-y-4 max-w-md mx-auto">

      <!-- ================= TAB 1: DAILY MATRIX VIEW ================= -->
      <section id="tabContentMatrix" class="space-y-4">

        <!-- Mobile Horizontal KPI Cards Slider -->
        <div class="flex gap-2.5 overflow-x-auto no-scrollbar pb-1">
          <!-- Card 1: Hours -->
          <div class="min-w-[130px] flex-1 st-glass p-3 rounded-2xl flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span id="card1Title" class="text-[10px] font-bold uppercase text-[var(--st-text-muted)]">कुल समय</span>
              <span class="text-[9px] px-1.5 py-0.5 rounded-md bg-blue-500/10 text-blue-500 font-mono font-black">HRS</span>
            </div>
            <div class="mt-1">
              <span id="metricTotalHours" class="text-xl font-display font-black text-sky-600 dark:text-sky-400">0.0h</span>
              <span class="text-[10px] text-[var(--st-text-muted)] font-mono block" id="metricHoursTarget">/ 0h goal</span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="barOverallPct" class="h-full bg-sky-500 rounded-full" style="width: 0%"></div>
            </div>
          </div>

          <!-- Card 2: Today's Target -->
          <div class="min-w-[130px] flex-1 st-glass p-3 rounded-2xl flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span id="card2Title" class="text-[10px] font-bold uppercase text-[var(--st-text-muted)]">आज का अध्ययन</span>
              <span class="text-[9px] font-mono font-bold text-[var(--st-text-muted)]">D<span id="metricActiveDayNum">1</span></span>
            </div>
            <div class="mt-1">
              <span id="metricTodayHours" class="text-xl font-display font-black text-emerald-600 dark:text-emerald-400">0.0h</span>
              <span class="text-[10px] text-emerald-500 font-bold block mt-0.5" id="metricTodayRatio">0/0 Topics</span>
            </div>
            <p id="card2Note" class="text-[9px] text-[var(--st-text-muted)] mt-1 truncate">दैनिक लक्ष्य अनुसार</p>
          </div>

          <!-- Card 3: Streak -->
          <div class="min-w-[130px] flex-1 st-glass p-3 rounded-2xl flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span id="card3Title" class="text-[10px] font-bold uppercase text-[var(--st-text-muted)]">कंसिस्टेंसी</span>
              <div class="flex items-center gap-1">
                <button onclick="useStreakFreezeShield()" id="btnStreakFreeze" class="text-[9px] px-1 py-0.5 rounded bg-sky-500/10 text-sky-500 font-bold">
                  🛡️ <span id="shieldCount">2</span>
                </button>
                <span class="text-sm st-flame-icon">🔥</span>
              </div>
            </div>
            <div class="mt-1">
              <span id="metricStreakDays" class="text-xl font-display font-black text-amber-500">0 दिन</span>
            </div>
            <p id="card3Note" class="text-[9px] text-[var(--st-text-muted)] mt-1 truncate">बिना ब्रेक निरंतर</p>
          </div>
        </div>

        <!-- Telemetry Strip -->
        <div class="st-glass px-3.5 py-2 rounded-2xl flex items-center justify-between text-[11px] font-mono">
          <div class="flex items-center gap-1.5 truncate">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping flex-shrink-0"></span>
            <span class="font-bold text-[var(--st-text-head)] truncate" id="telemetryForecast">गति विश्लेषण...</span>
          </div>
          <span class="text-sky-500 font-bold flex-shrink-0" id="telemetryPace">0.0h/day</span>
        </div>

        <!-- Mindset, Sleep & PYQ Speed Bar -->
        <div class="st-glass p-3.5 rounded-2xl space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black uppercase text-[var(--st-text-muted)] flex items-center gap-1.5">
              <span>🧠</span> माइंडसेट
            </span>
            <div class="flex items-center gap-1">
              <button onclick="setDailyEnergy('high')" id="btnEnergyHigh" class="px-2 py-1 rounded-lg text-[10px] font-bold st-subtle">⚡ फोकस</button>
              <button onclick="setDailyEnergy('med')" id="btnEnergyMed" class="px-2 py-1 rounded-lg text-[10px] font-bold st-subtle">🔋 सामान्य</button>
              <button onclick="setDailyEnergy('low')" id="btnEnergyLow" class="px-2 py-1 rounded-lg text-[10px] font-bold st-subtle">🪫 थकान</button>
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-[var(--st-border)] text-xs">
            <!-- Sleep Selector -->
            <div class="flex items-center gap-1.5">
              <span class="text-[11px] font-bold text-[var(--st-text-muted)]">😴 नींद:</span>
              <select id="selectSleepHours" onchange="setDailySleep(this.value)" class="px-2 py-1 rounded-lg st-subtle text-[11px] font-mono font-bold outline-none text-sky-500">
                <option value="5">5h</option>
                <option value="6">6h</option>
                <option value="7" selected>7h</option>
                <option value="8">8h</option>
                <option value="9">9h+</option>
              </select>
            </div>

            <!-- Notes Button -->
            <button onclick="openDailyNotesModal()" class="px-2.5 py-1 rounded-xl bg-indigo-500/10 text-indigo-500 border border-indigo-500/20 font-bold text-[11px] flex items-center gap-1">
              <span>📓</span> <span>दैनिक नोट्स</span>
            </button>
          </div>

          <!-- PYQ Accuracy Meter -->
          <div class="pt-2 border-t border-[var(--st-border)] flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-xs">🎯</span>
              <span class="text-xs font-bold text-[var(--st-text-muted)]">PYQ अभ्यास:</span>
              <span id="displayPyqAccuracy" class="text-[10px] font-mono font-black text-emerald-500 px-1.5 py-0.2 rounded bg-emerald-500/10">0% Acc</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button onclick="adjustDetailedPyq('correct', -5)" class="w-6 h-6 rounded st-subtle font-black text-xs">-</button>
              <span id="valPyqCorrect" class="font-mono font-black text-xs text-emerald-500 min-w-[16px] text-center">0</span>
              <button onclick="adjustDetailedPyq('correct', 5)" class="w-6 h-6 rounded bg-emerald-500/10 text-emerald-500 font-black text-xs">+</button>
              <span class="text-[10px] font-bold text-[var(--st-text-muted)] ml-1">कुल: <b id="displayTodayPyq" class="text-[var(--st-text-head)]">0</b></span>
            </div>
          </div>
        </div>

        <!-- 1-7-30 Spaced Repetition Due Alert Strip -->
        <div id="spacedRepetitionSuperAlert" class="hidden st-glass p-3.5 rounded-2xl border-2 border-rose-500/50 bg-gradient-to-r from-rose-500/10 via-amber-500/5 to-sky-500/10 space-y-2 st-animate-fade">
          <div class="flex items-center justify-between pb-1.5 border-b border-[var(--st-border)]">
            <div class="flex items-center gap-1.5">
              <span class="text-base st-flame-icon">🚨</span>
              <h3 class="text-xs font-black text-rose-600 dark:text-rose-400">1-7-30 रिवीजन अलर्ट</h3>
            </div>
            <span id="badgeRevisionDueCount" class="text-[10px] font-black px-2 py-0.5 rounded-full bg-rose-500 text-white animate-pulse">0 Due</span>
          </div>
          <div id="spacedRepetitionCardsList" class="space-y-2"></div>
        </div>

        <!-- Revision Queue Banner -->
        <div id="wrapperRevisionQueue" class="hidden st-glass p-3 rounded-2xl border border-amber-500/30 bg-amber-500/5 flex flex-wrap items-center justify-between gap-2 text-xs">
          <div class="flex items-center gap-1.5 text-amber-600 dark:text-amber-400 font-bold text-[11px]">
            <span>🔄</span> <span>आज रिवीजन देय है:</span>
          </div>
          <div id="revisionQueueBadges" class="flex flex-wrap items-center gap-1.5"></div>
        </div>

        <!-- Today Checklist Section -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between px-1">
            <h3 class="text-xs font-black uppercase tracking-wider text-[var(--st-text-muted)] flex items-center gap-1.5">
              <span>📋</span> <span id="mobileSliderTitle">आज का दिन (Locked to Live Date)</span>
            </h3>
            <span class="text-[10px] font-mono font-bold text-sky-500" id="liveDateString">Loading date...</span>
          </div>

          <!-- Date Carousel Slider -->
          <div id="mobileDaysContainer" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1"></div>

          <!-- Mobile Subject Cards Container -->
          <div id="mobileCardsContainer" class="space-y-2.5"></div>
        </div>

        <!-- Hidden desktop table elements maintained to preserve JS queries -->
        <div class="hidden">
          <span id="displayLiveClockDisplay"></span>
          <span id="liveClockDisplay"></span>
          <span id="liveDateDisplay"></span>
          <span id="badgeARI"></span>
          <span id="badgeEfficiency"></span>
          <span id="lblManifestoPost"></span>
          <span id="metricTopSubject"></span>
          <span id="metricTopSubjectScore"></span>
          <span id="metricWeakSubject"></span>
          <span id="card5Note"></span>
          <span id="valPyqWrong"></span>
          <span id="telemetryBurnout"></span>
          <span id="telemetryCutoffProb"></span>
          <span id="btnDailyNotesText"></span>
          <span id="mobileActiveDateBadge"></span>
          <span id="desktopTableTitle"></span>
          <span id="desktopTableSubtitle"></span>
          <span id="desktopLangLabel"></span>
          <span id="desktopThemeIcon"></span>
          <span id="desktopThemeLabel"></span>
          <span id="labelBtnAdd"></span>
          <span id="labelBtnManage"></span>
          <span id="appSubtitle"></span>
          <span id="card4Title"></span>
          <span id="card5Title"></span>
          <span id="tabLabelMatrix"></span>
          <span id="tabLabelFocus"></span>
          <span id="tabLabelMocks"></span>
          <span id="tabLabelWarroom"></span>
          <span id="tabLabelAnalytics"></span>
          <button id="btnDesktopSound"></button>
          <table>
            <thead id="desktopThead"></thead>
            <tbody id="desktopTbody"></tbody>
            <tfoot id="desktopTfoot"></tfoot>
          </table>
        </div>

      </section>

      <!-- ================= TAB 2: SPACED HUB VIEW ================= -->
      <section id="tabContentSpacedhub" class="hidden space-y-4">
        <div class="st-glass p-4 rounded-2xl space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🔁</span>
            <div>
              <h2 class="text-sm font-black text-[var(--st-text-head)]">1-7-30 वैज्ञानिक रिवीजन कमांड हब</h2>
              <p class="text-[11px] text-[var(--st-text-muted)]">एबिंगहॉस फॉरगेटिंग कर्व को वैज्ञानिक रूप से हराएं</p>
            </div>
          </div>

          <!-- KPI Counters -->
          <div class="grid grid-cols-2 gap-2 text-center text-xs">
            <div class="p-2.5 rounded-xl st-subtle border border-rose-500/30">
              <span class="text-[10px] uppercase font-bold text-rose-500 block">आज देय (Due)</span>
              <span id="kpiSpacedDueToday" class="text-xl font-black font-mono text-rose-500">0</span>
