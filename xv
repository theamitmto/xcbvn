    function setDailySleep(val) {
      const realToday = new Date().getDate();
      if (!appState.dailySleep) appState.dailySleep = {};
      appState.dailySleep[realToday] = val;
      persistAppState();
      playHapticPop(500, 'sine', 0.05);
    }

    function updateSleepDisplay() {
      const realToday = new Date().getDate();
      const val = (appState.dailySleep && appState.dailySleep[realToday]) || '7';
      const sel = document.getElementById('selectSleepHours');
      if (sel) sel.value = val;
    }

    function adjustDetailedPyq(type, delta) {
      const realToday = new Date().getDate();
      if (!appState.dailyPyqDetail) appState.dailyPyqDetail = {};
      if (!appState.dailyPyqDetail[realToday]) appState.dailyPyqDetail[realToday] = { correct: 0, wrong: 0 };
      const cur = appState.dailyPyqDetail[realToday];
      if (type === 'correct') cur.correct = Math.max(0, (cur.correct || 0) + delta);
      persistAppState();
      updateDetailedPyqDisplay();
      playHapticPop(delta > 0 ? 640 : 420, 'sine', 0.05);
    }

    function updateDetailedPyqDisplay() {
      const realToday = new Date().getDate();
      const data = (appState.dailyPyqDetail && appState.dailyPyqDetail[realToday]) || { correct: 0, wrong: 0 };
      document.getElementById('valPyqCorrect').textContent = data.correct || 0;
      document.getElementById('displayTodayPyq').textContent = data.correct || 0;
    }

    function renderWarRoomView() {
      const q1 = document.getElementById('quadrantQ1');
      const q2 = document.getElementById('quadrantQ2');
      const q3 = document.getElementById('quadrantQ3');
      const q4 = document.getElementById('quadrantQ4');
      const urgent = document.getElementById('warroomUrgentList');
      const safe = document.getElementById('warroomSafeList');

      if (!q1) return;
      q1.innerHTML = ''; q2.innerHTML = ''; q3.innerHTML = ''; q4.innerHTML = '';
      urgent.innerHTML = ''; safe.innerHTML = '';

      const totalDays = daysInMonth(currentYear, currentMonth);
      let totalWeighted = 0;

      appState.items.forEach(it => {
        const checks = appState.checks[it.id] || {};
        const done = Object.values(checks).filter(Boolean).length;
        const ratio = (done / (it.goal || 25));
        totalWeighted += ratio;

        const pill = `<div class="p-1 rounded st-glass flex justify-between"><span>${it.icon} ${it.name}</span><b>${Math.round(ratio*100)}%</b></div>`;
        if (ratio < 0.4) {
          q1.innerHTML += pill;
          urgent.innerHTML += `<div class="p-2 rounded-xl st-subtle text-rose-500 font-bold flex justify-between"><span>${it.icon} ${it.name}</span><span>${Math.round(ratio*100)}%</span></div>`;
        } else if (ratio >= 0.7) {
          q2.innerHTML += pill;
          safe.innerHTML += `<div class="p-2 rounded-xl st-subtle text-emerald-500 font-bold flex justify-between"><span>${it.icon} ${it.name}</span><span>${Math.round(ratio*100)}%</span></div>`;
        } else if (ratio < 0.5) {
          q3.innerHTML += pill;
        } else {
          q4.innerHTML += pill;
        }
      });

      const avg = appState.items.length ? Math.round((totalWeighted / appState.items.length) * 100) : 0;
      document.getElementById('warroomReadinessScore').textContent = `${avg}% Ready`;
    }

    function populateFocusSubjectOptions() {
      const sel = document.getElementById('selectFocusSubjectLog');
      if (!sel) return;
      sel.innerHTML = '';
      if (!appState.items || appState.items.length === 0) {
        sel.innerHTML = '<option value="">कोई विषय उपलब्ध नहीं</option>';
        return;
      }
      appState.items.forEach(it => {
        const opt = document.createElement('option');
        opt.value = it.id;
        opt.textContent = `${it.icon || '📖'} ${it.name}`;
        sel.appendChild(opt);
      });
    }

    function copyDailyTelegramReport() {
      const realToday = new Date().getDate();
      const hours = document.getElementById('metricTodayHours').textContent;
      const streak = document.getElementById('metricStreakDays').textContent;
      let msg = `🎯 *Smart Study Pro Daily Report*\n👤 ${studentName}\n⏱️ Time: ${hours}\n🔥 Streak: ${streak}\nConsistent study unlocks success! 🚀`;
      const dummy = document.createElement("textarea");
      document.body.appendChild(dummy);
      dummy.value = msg;
      dummy.select();
      document.execCommand("copy");
      document.body.removeChild(dummy);
      showInAppToast('📋 स्टेटस क्लिपबोर्ड पर कॉपी हुआ!');
    }

    // ================= CHAPTERS & RESOURCES =================
    let currentManagingTopicId = null;
    function openTopicModal(id) {
      currentManagingTopicId = id;
      const it = appState.items.find(x => x.id === id);
      if (!it) return;

      document.getElementById('topicModalHeading').innerHTML = `${it.icon || '📚'} ${it.name}`;
      document.getElementById('topicModalSub').textContent = `${it.cat} • Target: ${it.goal}d`;
      document.getElementById('inputTopicSource').value = (appState.subjectSources && appState.subjectSources[id]) || '';
      switchTopicModalTab('chapters');
      document.getElementById('modalTopicManager').classList.remove('hidden');
    }

    function switchTopicModalTab(tab) {
      const vChaps = document.getElementById('viewTopicChapters');
      const vLogs = document.getElementById('viewTopicLogs');
      if (tab === 'chapters') {
        vChaps.classList.remove('hidden');
        vLogs.classList.add('hidden');
        renderChaptersList();
      } else {
        vChaps.classList.add('hidden');
        vLogs.classList.remove('hidden');
        renderTopicLogsList();
      }
    }

    function renderChaptersList() {
      const container = document.getElementById('topicChaptersList');
      if (!container || !currentManagingTopicId) return;
      const list = (appState.microTopics && appState.microTopics[currentManagingTopicId]) || [];
      document.getElementById('chaptersCountLabel').textContent = `${list.length} Chapters`;

      if (list.length === 0) {
        container.innerHTML = `<div class="p-4 text-center text-xs text-[var(--st-text-muted)]">कोई अध्याय नहीं है।</div>`;
        return;
      }
      container.innerHTML = list.map(c => `
        <div class="flex items-center justify-between p-2 rounded-xl st-subtle text-xs">
          <label class="flex items-center gap-2 cursor-pointer ${c.done ? 'line-through opacity-60' : ''}">
            <input type="checkbox" class="w-4 h-4 accent-sky-500 rounded" ${c.done ? 'checked' : ''} onchange="toggleChapterDone('${c.id}', this.checked)">
            <span>${c.name}</span>
          </label>
          <button onclick="deleteChapter('${c.id}')" class="text-rose-500">✕</button>
        </div>
      `).join('');
    }

    function renderTopicLogsList() {
      const container = document.getElementById('topicSpacedLogsList');
      if (!container || !currentManagingTopicId) return;
      const logs = (appState.spacedLogs || []).filter(l => String(l.itemId) === String(currentManagingTopicId));

      if (logs.length === 0) {
        container.innerHTML = `<div class="p-4 text-center text-xs text-[var(--st-text-muted)]">इस विषय का कोई पूर्व लॉग नहीं है।</div>`;
        return;
      }
      container.innerHTML = logs.map(l => `
        <div class="p-2.5 rounded-xl st-subtle space-y-1 text-xs">
          <div class="flex justify-between font-mono text-[10px] text-sky-500">
            <span>📅 ${l.studiedDate}</span>
            <span>${l.totalPages} Pages</span>
          </div>
          <h5 class="font-bold text-[var(--st-text-head)]">${l.topic}</h5>
          <span class="text-[10px] text-emerald-500 font-mono">📄 ${l.pageRange}</span>
        </div>
      `).join('');
    }

    function closeTopicModal() {
      document.getElementById('modalTopicManager').classList.add('hidden');
      currentManagingTopicId = null;
    }

    function saveSubjectSource() {
      if (!currentManagingTopicId) return;
      if (!appState.subjectSources) appState.subjectSources = {};
      appState.subjectSources[currentManagingTopicId] = document.getElementById('inputTopicSource').value.trim();
      persistAppState();
      showInAppToast('स्रोत सुरक्षित हुआ!');
    }

    function addNewChapter() {
      if (!currentManagingTopicId) return;
      const name = document.getElementById('inputNewChapterName').value.trim();
      if (!name) return;
      if (!appState.microTopics) appState.microTopics = {};
      if (!appState.microTopics[currentManagingTopicId]) appState.microTopics[currentManagingTopicId] = [];

      appState.microTopics[currentManagingTopicId].push({ id: 'chap_' + Date.now(), name, done: false });
      persistAppState();
      renderChaptersList();
      renderAllComponents();
      document.getElementById('inputNewChapterName').value = '';
    }

    function toggleChapterDone(chapId, isDone) {
      if (!currentManagingTopicId || !appState.microTopics[currentManagingTopicId]) return;
      const c = appState.microTopics[currentManagingTopicId].find(x => x.id === chapId);
      if (c) c.done = isDone;
      persistAppState();
      renderChaptersList();
    }

    function deleteChapter(chapId) {
      if (!currentManagingTopicId || !appState.microTopics[currentManagingTopicId]) return;
      appState.microTopics[currentManagingTopicId] = appState.microTopics[currentManagingTopicId].filter(x => x.id !== chapId);
      persistAppState();
      renderChaptersList();
      renderAllComponents();
    }

    function generatePrintReport() {
      const tableBody = document.getElementById('printTableBody');
      const totalDays = daysInMonth(currentYear, currentMonth);

      document.getElementById('printExamDetails').textContent = `Exam: ${targetExamName || 'General Studies'}`;
      document.getElementById('printStudentDetails').textContent = `Aspirant: ${studentName || 'Student'}`;
      document.getElementById('printReportDate').textContent = `${MONTH_NAMES[currentLang][currentMonth]} ${currentYear}`;
      document.getElementById('printTotalHours').textContent = document.getElementById('metricTotalHours').textContent;
      document.getElementById('printStreak').textContent = document.getElementById('metricStreakDays').textContent;

      if (appState.items) {
        tableBody.innerHTML = appState.items.map(it => {
          const checks = appState.checks[it.id] || {};
          let done = 0;
          for (let d = 1; d <= totalDays; d++) { if (checks[d]) done++; }
          const pct = Math.min(100, Math.round((done / (it.goal || 25)) * 100));
          return `
            <tr>
              <td class="p-2 border font-semibold">${it.icon || ''} ${it.name}</td>
              <td class="p-2 border text-center">${it.cat || 'General'}</td>
              <td class="p-2 border text-center font-mono">${it.hours || 1}h</td>
              <td class="p-2 border text-center font-mono">${done}/${it.goal}d</td>
              <td class="p-2 border text-center font-mono font-bold">${pct}%</td>
            </tr>
          `;
        }).join('');
      }
      window.print();
    }
  </script>
</body>
</html>
