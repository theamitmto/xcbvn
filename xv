    // ================= REFRESH METRICS & CHARTS =================
    function refreshMetricsAndCharts() {
      const totalDays = daysInMonth(currentYear, currentMonth);
      const totalItems = appState.items ? appState.items.length : 0;
      let totalCompletedAll = 0;
      let totalGoalAll = 0;
      let totalHoursInvested = 0;
      let targetHoursTotal = 0;
      let itemScores = [];

      if (appState.items) {
        appState.items.forEach(it => {
          const goal = it.goal || 25;
          const hrs = it.hours || 1;
          totalGoalAll += goal;
          targetHoursTotal += (goal * hrs);

          let done = 0;
          const checks = appState.checks[it.id] || {};
          for (let d = 1; d <= totalDays; d++) {
            if (checks[d]) {
              done++;
              totalHoursInvested += hrs;
            }
          }
          totalCompletedAll += done;
          itemScores.push({
            name: it.name,
            icon: it.icon,
            done, goal, hoursPerDay: hrs,
            totalHoursSpent: done * hrs,
            ratio: goal > 0 ? (done / goal) : 0
          });
        });
      }

      document.getElementById('metricTotalHours').textContent = `${totalHoursInvested.toFixed(1)}h`;
      document.getElementById('metricHoursTarget').textContent = `/ ${targetHoursTotal.toFixed(0)}h goal`;
      const overallPct = targetHoursTotal > 0 ? Math.min(100, Math.round((totalHoursInvested / targetHoursTotal) * 100)) : 0;
      document.getElementById('barOverallPct').style.width = `${overallPct}%`;

      const isCurrentMonth = new Date().getFullYear() === currentYear && new Date().getMonth() === currentMonth;
      const todayDay = isCurrentMonth ? new Date().getDate() : 1;
      let todayDone = 0;
      let todayHours = 0;
      if (appState.items) {
        appState.items.forEach(it => {
          if (appState.checks[it.id] && appState.checks[it.id][todayDay]) {
            todayDone++;
            todayHours += (it.hours || 1);
          }
        });
      }
      document.getElementById('metricTodayHours').textContent = `${todayHours.toFixed(1)}h`;
      document.getElementById('metricTodayRatio').textContent = `${todayDone}/${totalItems} Done`;

      let streak = 0;
      for (let d = todayDay; d >= 1; d--) {
        let dailyLogged = 0;
        if (appState.items) {
          appState.items.forEach(it => {
            if (appState.checks[it.id] && appState.checks[it.id][d]) dailyLogged++;
          });
        }
        if (dailyLogged > 0) streak++;
        else break;
      }
      document.getElementById('metricStreakDays').textContent = `${streak} दिन`;

      const rankBadge = document.getElementById('badgeRank');
      if (rankBadge) {
        let rankText = 'Novice';
        if (streak >= 25 || totalHoursInvested >= 150) rankText = 'Beast';
        else if (streak >= 15 || totalHoursInvested >= 90) rankText = 'Slayer';
        else if (streak >= 7 || totalHoursInvested >= 40) rankText = 'Scholar';
        rankBadge.textContent = rankText;
      }

      const pace = todayDay > 0 ? (totalHoursInvested / todayDay).toFixed(1) : '0.0';
      document.getElementById('telemetryPace').textContent = `${pace}h/day`;
      const remainingHours = Math.max(0, targetHoursTotal - totalHoursInvested);
      const daysNeeded = parseFloat(pace) > 0 ? Math.ceil(remainingHours / parseFloat(pace)) : 0;
      document.getElementById('telemetryForecast').textContent = `अनुमान: ~${daysNeeded} दिन शेष`;

      document.getElementById('valDoughnutDone').textContent = `${totalHoursInvested.toFixed(0)} hrs`;
      document.getElementById('valDoughnutLeft').textContent = `${Math.max(0, targetHoursTotal - totalHoursInvested).toFixed(0)} hrs`;

      updateChartsData(totalDays, totalItems, itemScores);
    }

