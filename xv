    function openTopicStudyLogModal(itemId, day) {
      pendingLogState = { itemId, day };
      const item = appState.items.find(x => String(x.id) === String(itemId));
      if (!item) return;

      document.getElementById('logModalSubjectHeader').textContent = `${item.icon || '📌'} ${item.name} (${item.cat || 'General'}) • Day ${day}`;
      document.getElementById('inputLogTopicName').value = '';
