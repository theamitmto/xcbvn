    function toggleTimerPlay() {
      timerRunning = !timerRunning;
      const icon = document.getElementById('timerPlayIcon');
      const txt = document.getElementById('timerPlayText');

      if (timerRunning) {
        if (icon) icon.textContent = '⏸';
        if (txt) txt.textContent = 'रोकें (Pause)';
        playHapticPop(600, 'sine', 0.08);

        lastTickTime = performance.now();
        let secondAccumulator = 0;

        timerInterval = setInterval(() => {
          const now = performance.now();
          const delta = now - lastTickTime;
          lastTickTime = now;

          secondAccumulator += delta;
          if (secondAccumulator >= 1000) {
            const passedSecs = Math.floor(secondAccumulator / 1000);
            totalFocusSecondsToday += passedSecs;
            secondAccumulator %= 1000;
            localStorage.setItem('st_focus_sec_today', totalFocusSecondsToday);
            renderPomodoroOrbs();
          }

          if (timerMode === 'stopwatch') {
            stopwatchMs += delta;
            updateTimerDisplay();
          } else {
            if (timerMsLeft > delta) {
              timerMsLeft -= delta;
              updateTimerDisplay();
            } else {
              timerMsLeft = 0;
              clearInterval(timerInterval);
              timerRunning = false;
              if (icon) icon.textContent = '▶';
              if (txt) txt.textContent = 'सत्र शुरू करें';
              completedPomodorosToday++;
              localStorage.setItem('st_pomos_today', completedPomodorosToday);
              renderPomodoroOrbs();
              updateTimerDisplay();
              playHapticPop(850, 'sine', 0.35);
              if (typeof confetti === 'function') confetti({ particleCount: 75, spread: 70 });
              showInAppToast('🎯 शानदार! सत्र पूरा हुआ!', '🏆');
            }
          }
        }, 30);
      } else {
        clearInterval(timerInterval);
        if (icon) icon.textContent = '▶';
        if (txt) txt.textContent = 'जारी रखें';
        playHapticPop(420, 'sine', 0.06);
        updateTimerDisplay();
      }
    }

    function resetTimer() {
      if (timerRunning) toggleTimerPlay();
      if (timerMode === 'stopwatch') stopwatchMs = 0;
      else timerMsLeft = timerTotalMs;
      updateTimerDisplay();
      playHapticPop(360, 'sine', 0.06);
    }

    function updateTimerDisplay() {
      const mDisplay = document.getElementById('timerMinsDisplay');
      const sDisplay = document.getElementById('timerSecsDisplay');
      const msDisplay = document.getElementById('timerMsDisplay');
      const circle = document.getElementById('timerProgressCircle');
      const progressLabel = document.getElementById('sessionProgressPct');
      const endLabel = document.getElementById('sessionEndTimeDisplay');

      const totalMs = timerMode === 'stopwatch' ? stopwatchMs : timerMsLeft;
      const totalSec = Math.floor(totalMs / 1000);
      const mins = Math.floor(totalSec / 60);
      const secs = totalSec % 60;
      const nanoPulse = Math.floor((totalMs % 1000) / 10);

      if (mDisplay) mDisplay.textContent = String(mins).padStart(2, '0');
      if (sDisplay) sDisplay.textContent = String(secs).padStart(2, '0');
      if (msDisplay) msDisplay.textContent = String(nanoPulse).padStart(2, '0');

      if (endLabel) {
        if (timerMode === 'stopwatch') {
          endLabel.textContent = 'Stopwatch Running';
        } else {
          const now = new Date();
          now.setMilliseconds(now.getMilliseconds() + timerMsLeft);
          const endHours = String(now.getHours() % 12 || 12).padStart(2, '0');
          const endMins = String(now.getMinutes()).padStart(2, '0');
          const ampm = now.getHours() >= 12 ? 'PM' : 'AM';
          endLabel.textContent = `Finishes at ${endHours}:${endMins} ${ampm}`;
        }
      }

      const circumference = 720;
      if (timerMode === 'stopwatch') {
        if (circle) circle.style.strokeDashoffset = '0';
        if (progressLabel) progressLabel.textContent = `Running: ${mins}m ${secs}s`;
      } else {
        const ratio = timerTotalMs > 0 ? (timerMsLeft / timerTotalMs) : 1;
        const offset = circumference * (1 - ratio);
        if (circle) circle.style.strokeDashoffset = String(offset);
        const percentDone = Math.round((1 - ratio) * 100);
        if (progressLabel) progressLabel.textContent = `Progress: ${percentDone}%`;
      }
    }

