    function cancelTopicStudyLog() {
      document.getElementById('modalTopicStudyLog').classList.add('hidden');
      pendingLogState = null;
      renderAllComponents();
    }

    function confirmTopicStudyLog() {
      if (!pendingLogState) return;

      const topicInput = document.getElementById('inputLogTopicName');
      const pageInput = document.getElementById('inputLogPageRange');
      const totalPagesInput = document.getElementById('inputLogTotalPages');
      const notesInput = document.getElementById('inputLogKeyNotes');

      const topicName = topicInput.value.trim();
      const pageRange = pageInput.value.trim();
      const totalPages = totalPagesInput.value.trim();
      const keyNotes = notesInput.value.trim();

      if (!topicName || !pageRange) {
        showInAppToast(currentLang === 'hi' ? 'टॉपिक और पेज नंबर अनिवार्य हैं!' : 'Topic and page range required!', '⚠️');
        return;
      }

      const { itemId, day } = pendingLogState;
      const item = appState.items.find(x => String(x.id) === String(itemId));

      if (!appState.checks[itemId]) appState.checks[itemId] = {};
      appState.checks[itemId][day] = true;

      const baseDate = new Date();
      function getOffsetDateString(offsetDays) {
        const d = new Date(baseDate);
        d.setDate(d.getDate() + offsetDays);
        return d.toISOString().split('T')[0];
      }

      const newLog = {
        id: 'spaced_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
        itemId: itemId,
        subjectName: item ? item.name : 'Subject',
        subjectIcon: item ? (item.icon || '📖') : '📖',
        topic: topicName,
        pageRange: pageRange,
        totalPages: totalPages || '1',
        keyNotes: keyNotes,
        studiedDate: baseDate.toISOString().split('T')[0],
        dayLogged: day,
        rev1Date: baseDate.toISOString().split('T')[0],
        rev1Done: true,
        rev7Date: getOffsetDateString(7),
        rev7Done: false,
        rev30Date: getOffsetDateString(30),
        rev30Done: false
      };

      if (!appState.spacedLogs) appState.spacedLogs = [];
      appState.spacedLogs.unshift(newLog);

      persistAppState();
      document.getElementById('modalTopicStudyLog').classList.add('hidden');
      pendingLogState = null;

      renderAllComponents();
      refreshMetricsAndCharts();
      renderSpacedRepetitionSuperAlert();
      if (activeTab === 'spacedhub') renderSpacedHubTable();

      playHapticPop(680, 'sine', 0.15);
      showInAppToast(currentLang === 'hi' ? `✅ आज का अध्ययन दर्ज! अगला रिवीजन 7वें दिन (${newLog.rev7Date}) अनलॉक होगा।` : `✅ Studied today! Next revision in 7 days (${newLog.rev7Date}).`, '🎯');
      checkDailyCompletionConfetti(day);
    }

    function markSpacedRevisionCompleted(logId, revStage) {
      if (!appState.spacedLogs) return;
      const target = appState.spacedLogs.find(x => x.id === logId);
      if (!target) return;

      const todayStr = new Date().toISOString().split('T')[0];
      if (revStage === 7) {
        if (target.rev7Date > todayStr) {
          showInAppToast(currentLang === 'hi' ? `🔒 7-Day रिवीजन ${target.rev7Date} को ही अनलॉक होगा!` : `🔒 Unlocks on ${target.rev7Date}!`, '⏳');
          return;
        }
        target.rev7Done = true;
      } else if (revStage === 30) {
        if (!target.rev7Done) {
          showInAppToast(currentLang === 'hi' ? '🔒 पहले 7-Day रिवीजन पूर्ण करें!' : '🔒 Complete 7-Day revision first!', '⚠️');
          return;
        }
        if (target.rev30Date > todayStr) {
          showInAppToast(currentLang === 'hi' ? `🔒 30-Day रिवीजन ${target.rev30Date} को ही अनलॉक होगा!` : `🔒 Unlocks on ${target.rev30Date}!`, '⏳');
          return;
        }
        target.rev30Done = true;
      }

      persistAppState();
      renderSpacedRepetitionSuperAlert();
      renderRevisionQueueBanner();
      if (activeTab === 'spacedhub') renderSpacedHubTable();
      playHapticPop(780, 'sine', 0.18);

      if (typeof confetti === 'function') {
        confetti({ particleCount: 60, spread: 60, origin: { y: 0.5 } });
      }
      showInAppToast(currentLang === 'hi' ? `🎉 ${revStage}-डे रिवीजन पूर्ण!` : `🎉 ${revStage}-Day Revision done!`, '🏆');
    }

